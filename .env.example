# Homepage doodle “send to author”
# Local: copy to .env.local
# Cloudflare: `npx wrangler secret put HERO_DOODLE_WEBHOOK_URL`

# Option A (recommended on Cloudflare): Discord channel webhook
# Discord → Channel settings → Integrations → Webhooks → New Webhook → Copy URL
HERO_DOODLE_WEBHOOK_URL=

# Option B: Resend email to you
RESEND_API_KEY=
HERO_DOODLE_TO_EMAIL=mattili2@outlook.com
HERO_DOODLE_FROM_EMAIL=Portfolio <onboarding@resend.dev>
