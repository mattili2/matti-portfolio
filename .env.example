# Homepage doodle “send to author”
# Local: copy to .env.local
# Cloudflare: `npx wrangler secret put RESEND_API_KEY`

# Email via Resend (recommended)
# 1. Sign up at https://resend.com with mattili2@outlook.com
# 2. Dashboard → API Keys → Create API Key
# 3. Free tier: send from onboarding@resend.dev to your signup email only
RESEND_API_KEY=
HERO_DOODLE_TO_EMAIL=mattili2@outlook.com
HERO_DOODLE_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Optional: Discord webhook (if HERO_DOODLE_WEBHOOK_URL is set, it takes priority over email)
# HERO_DOODLE_WEBHOOK_URL=
